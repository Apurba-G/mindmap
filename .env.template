# ============================================================
# MindMap Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Database
DB_USER=mindmap
DB_PASSWORD=mindmap_secret_change_me

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=YOUR_JWT_SECRET_HERE_MUST_BE_AT_LEAST_64_CHARS_LONG_REPLACE_THIS

# Admin initial password (must be changed on first login)
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_SECURE_INITIAL_PASSWORD

# AES-256 encryption key for data at rest (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=YOUR_AES_256_KEY_HERE_64_HEX_CHARS_REPLACE_THIS_VALUE
